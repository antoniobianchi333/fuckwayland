#!/bin/sh
# What this script does, and just as importantly what it does not.
#
# DOES: apply the udev rule the package just installed to the /dev/uinput that
# already exists, so that input injection works without a reboot -- exactly
# what `gnome/install-bridge.sh --udev` does by hand (modprobe, reload,
# trigger).  The rule itself only tags the node `uaccess`; systemd-logind then
# gives the user of the *active seat* an ACL on it, at every login as well as
# now.  The node stays root:root 0600; no group is involved.
#
# DOES NOT: touch any user's session.  Enabling a GNOME Shell extension is a
# per-user dconf setting, dpkg runs as root, and at install time there may be
# no session on the machine at all -- so the extension is installed
# system-wide here and enabled by /usr/lib/fuckwayland/enable-bridge in the
# user's own session at their next login.  Nothing here starts, stops or
# restarts gnome-shell either: it scans extension directories only at login,
# which is why the message below asks for one.
set -e

case "$1" in
configure)
    # A chroot/container image build has no udev and no /dev/uinput to fix up;
    # the rule and the modules-load.d file are on disk and apply at boot.
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
        modprobe uinput >/dev/null 2>&1 || true
        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger --name-match=uinput >/dev/null 2>&1 || true
        udevadm settle --timeout=5 >/dev/null 2>&1 || true
    fi

    if [ -z "$2" ]; then        # first install, not an upgrade
        cat <<'EOM'

fuckwayland: wdotool, wwmctl, wxprop, wxrandr, warandr and wmirror are on PATH.

  * On GNOME, the window commands need the bridge extension, and gnome-shell
    only scans extension directories at login: LOG OUT AND BACK IN ONCE.  The
    extension is installed and is enabled for you automatically in that first
    session.  wxrandr and warandr work already; until the relogin the window
    commands say the bridge is not running.
  * /dev/uinput is now open to the user at the active seat (udev rule
    60-fuckwayland-uinput.rules), which is what lets wdotool type and click
    without root.  Anyone who can open it can type as you -- see the threat
    model in /usr/share/doc/fuckwayland/README.md.gz.
  * On an X11 session the tools hand over to the real ones; install those
    with: apt install xdotool wmctrl

EOM
    fi
    ;;
esac

#DEBHELPER#
exit 0
